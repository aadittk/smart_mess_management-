{
  "name": "smartmess-backend",
  "version": "1.0.0",
  "description": "SmartMess - Smart Hostel Mess Management System Backend API",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --runInBand --detectOpenHandles --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint src/ --ext .js",
    "format": "prettier --write \"src/**/*.js\""
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.47.10",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "jest": "^25.1.0",
    "nodemon": "^3.1.9",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/src/scripts/"
    ],
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  }
}
